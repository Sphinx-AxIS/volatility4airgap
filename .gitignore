# Build outputs — all reproducible from tools/build_portable.py
/build/
/dist/
*.zip

# Vendored/downloaded binaries (fetched by the build script; see README)
/vendor/
/python/
/python_packages/
/lib/
volatility3.exe

# Artifacts of a *built bundle* unpacked over a checkout. All are produced by
# tools/build_portable.py, so none belongs in version control — and without these
# rules they are the files a stray `git add -A` would pick up. Anchored to the
# root so docs/HOWTO.md, the tracked original, is unaffected.
/BUILD-FILES.sha256
/BUILD-MANIFEST.json
/HOWTO.md
/v4ag.bat

# Symbol data — windows.zip is 800 MB, never commit
/symbols/
*.pdb
*.json.xz

# Run artifacts and case material — NEVER COMMIT.
# Plugin output names processes, users, hostnames and network peers from the
# examined host. Treat everything below as evidence, not as build output.
/output/
/cache/
symbol_request.json
*symbol*request*.json
*check_output.txt
/notes/
/cases/

# Analysis output. Covered by /output/ where triage wrote there, but --out and
# 'analyze <dir>' can put a run anywhere, and findings name the same processes,
# users, service binaries and network peers the plugin output does.
findings/
followup/
analysis-manifest.json

# Evidence — never commit memory images
*.raw
*.vmem
*.mem
*.dmp
*.lime
*.img
*.bin
*.elf
*.vhd
*.vhdx
*.e01
*.aff4

# Binaries extracted from evidence for local symbol generation.
# This project is pure Python, so no compiled artifact belongs in it.
/bin/
*.exe
*.dll
*.sys
*.sct
*.hta

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db
